import 'dotenv/config';
import express from 'express';
import path from 'path';
import { fileURLToPath } from 'url';
import { readFileSync, existsSync } from 'fs';
import admin from 'firebase-admin';
import multer from 'multer';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const port = process.env.PORT ? Number(process.env.PORT) : 3005;

const DEEPGRAM_API_KEY = process.env.DEEPGRAM_API_KEY;
if (!DEEPGRAM_API_KEY) {
  // Fail fast so we don't accidentally expose missing configuration.
  // eslint-disable-next-line no-console
  console.error('Missing DEEPGRAM_API_KEY in tools/deepgram-inspector/.env');
  process.exit(1);
}

const authHeader = `Token ${DEEPGRAM_API_KEY}`;

// Firebase Admin — optional. Only initialised when a service account key path
// is provided; the Deepgram side of the inspector still runs without it.
let firestoreDb = null;
{
  const credPath = process.env.FIREBASE_SERVICE_ACCOUNT_PATH;
  if (credPath) {
    const absPath = path.isAbsolute(credPath)
      ? credPath
      : path.join(__dirname, credPath);
    if (!existsSync(absPath)) {
      // eslint-disable-next-line no-console
      console.warn(
        `FIREBASE_SERVICE_ACCOUNT_PATH set but file not found at ${absPath} — feedback panel will be disabled.`,
      );
    } else {
      try {
        const serviceAccount = JSON.parse(readFileSync(absPath, 'utf8'));
        admin.initializeApp({
          credential: admin.credential.cert(serviceAccount),
        });
        firestoreDb = admin.firestore();
        // eslint-disable-next-line no-console
        console.log(`Firebase Admin initialised (project ${serviceAccount.project_id}).`);
      } catch (e) {
        // eslint-disable-next-line no-console
        console.warn(`Failed to initialise Firebase Admin: ${e.message}`);
      }
    }
  } else {
    // eslint-disable-next-line no-console
    console.log(
      'FIREBASE_SERVICE_ACCOUNT_PATH not set — feedback panel will return 503. ' +
        'Drop a service account JSON in tools/deepgram-inspector/ and point .env at it to enable.',
    );
  }
}

app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));

// In-inspector recording uploads — gated on GITHUB_TOKEN. When the env var is
// missing the upload endpoints return 503 and the frontend disables the
// Record button up front so the user doesn't get hit with a runtime failure.
const GITHUB_TOKEN = process.env.GITHUB_TOKEN;
const GITHUB_REPO_OWNER = 'sjpalnz';
const GITHUB_REPO_NAME = 'pub_darts_audio';
const GITHUB_BRANCH = 'main';
const ALLOWED_UPLOAD_EXTENSIONS = new Set(['m4a', 'webm', 'mp3', 'wav']);
if (GITHUB_TOKEN) {
  // eslint-disable-next-line no-console
  console.log(
    `GitHub upload enabled (target ${GITHUB_REPO_OWNER}/${GITHUB_REPO_NAME}@${GITHUB_BRANCH}).`,
  );
} else {
  // eslint-disable-next-line no-console
  console.log(
    'GITHUB_TOKEN not set — in-inspector recording uploads disabled.',
  );
}

// Audio files are small (a couple of seconds of speech); a 5 MB cap is plenty
// and protects against a runaway upload.
const upload = multer({
  storage: multer.memoryStorage(),
  limits: { fileSize: 5 * 1024 * 1024 },
});

function deepgramUrl(urlPath) {
  // Deepgram Management API base URL.
  return `https://api.deepgram.com${urlPath}`;
}

async function deepgramGet(urlPath, { query } = {}) {
  const qs = query ? `?${new URLSearchParams(query).toString()}` : '';
  const res = await fetch(deepgramUrl(`${urlPath}${qs}`), {
    method: 'GET',
    headers: {
      Authorization: authHeader,
      accept: 'application/json',
    },
  });

  const text = await res.text();
  let json;
  try {
    json = text ? JSON.parse(text) : null;
  } catch {
    json = null;
  }

  if (!res.ok) {
    return {
      ok: false,
      status: res.status,
      body: json ?? text,
    };
  }

  return { ok: true, status: res.status, body: json };
}

app.get('/api/projects', async (_req, res) => {
  const result = await deepgramGet('/v1/projects');
  if (!result.ok) {
    res.status(result.status).json({ error: result.body });
    return;
  }
  res.json(result.body);
});

app.get('/api/usage', async (req, res) => {
  const { project_id, start, end } = req.query;
  if (!project_id) {
    res.status(400).json({ error: 'project_id is required' });
    return;
  }
  const result = await deepgramGet(`/v1/projects/${project_id}/usage`, {
    query: { start, end },
  });
  if (!result.ok) {
    res.status(result.status).json({ error: result.body });
    return;
  }
  res.json(result.body);
});

app.get('/api/billing-breakdown', async (req, res) => {
  const { project_id, start, end, grouping } = req.query;
  if (!project_id) {
    res.status(400).json({ error: 'project_id is required' });
    return;
  }

  const result = await deepgramGet(`/v1/projects/${project_id}/billing/breakdown`, {
    query: {
      start,
      end,
      // group by line_item so we can attribute streaming costs
      grouping: grouping ?? 'line_item',
      // optional hint to reduce noise; not strictly required
      line_item: 'streaming::nova-3',
    },
  });

  if (!result.ok) {
    res.status(result.status).json({ error: result.body });
    return;
  }
  res.json(result.body);
});

app.get('/api/balances', async (req, res) => {
  const { project_id } = req.query;
  if (!project_id) {
    res.status(400).json({ error: 'project_id is required' });
    return;
  }

  const result = await deepgramGet(`/v1/projects/${project_id}/balances`);

  if (!result.ok) {
    res.status(result.status).json({ error: result.body });
    return;
  }

  res.json(result.body);
});

app.get('/api/requests', async (req, res) => {
  const { project_id, start, end, status, limit, page } = req.query;
  if (!project_id) {
    res.status(400).json({ error: 'project_id is required' });
    return;
  }

  const limitNum = limit == null || limit === '' ? 50 : Number(limit);
  const pageNum = page == null || page === '' ? 0 : Number(page);

  if (!Number.isFinite(limitNum) || limitNum <= 0) {
    res.status(400).json({ error: 'limit must be a positive number' });
    return;
  }
  if (!Number.isFinite(pageNum) || pageNum < 0) {
    res.status(400).json({ error: 'page must be 0 or a positive number' });
    return;
  }

  // Deepgram's Management API `/v1/projects/{id}/requests` (as of 2026) only
  // *documents* `start` and `end`, but `limit` and `page` are still honoured
  // (the response includes them back). The previously-supported filters —
  // `method`, `endpoint`, `deployment`, `status` — were retired and sending
  // them silently returns an empty list.
  //
  // Because the inspector is interested in STT only (the voice-scoring
  // `/v1/listen` calls) but Deepgram returns everything sorted by created
  // DESC, the first few pages of a TTS-heavy range can be entirely TTS and
  // filter to nothing. So we walk all pages, accumulate items, filter, and
  // paginate the filtered set ourselves.
  // Deepgram caps `limit` at 100 ("The maximum allowed number of pages
  // requested is 100" — yes, the error message is misleadingly worded).
  const upstreamPageSize = 100;
  const maxPagesToWalk = 100; // safety cap: 100 * 100 = 10k items
  const accumulated = [];
  for (let p = 0; p < maxPagesToWalk; p++) {
    const upstream = await deepgramGet(
      `/v1/projects/${project_id}/requests`,
      {
        query: {
          start,
          end,
          limit: String(upstreamPageSize),
          page: String(p),
        },
      },
    );
    if (!upstream.ok) {
      res.status(upstream.status).json({ error: upstream.body });
      return;
    }
    const items = Array.isArray(upstream.body?.requests)
      ? upstream.body.requests
      : [];
    accumulated.push(...items);
    if (items.length < upstreamPageSize) break; // last page
  }

  // STT only: paths under `/v1/listen` (covers `?query` strings too).
  let filtered = accumulated.filter((r) =>
    String(r?.path ?? '').startsWith('/v1/listen'),
  );

  // Succeeded filter. For HTTP requests (TTS, etc.) the status code is 2xx;
  // for streaming-over-WebSocket STT it's 101 (the upgrade response). The
  // common, mode-agnostic success signal is that `response.completed` is set
  // — Deepgram only populates that timestamp once the call finishes cleanly.
  if (status === 'succeeded') {
    filtered = filtered.filter((r) => {
      const completed = r?.response?.completed;
      if (typeof completed !== 'string' || !completed) return false;
      const code = Number(r?.response?.code);
      // Belt-and-braces: also reject explicit 4xx / 5xx if a code was given.
      if (Number.isFinite(code) && (code >= 400 || (code >= 300 && code < 400))) {
        return false;
      }
      return true;
    });
  }

  const total = filtered.length;
  const startIdx = pageNum * limitNum;
  const paged = filtered.slice(startIdx, startIdx + limitNum);
  res.json({
    page: pageNum,
    limit: limitNum,
    total,
    requests: paged,
  });
});

app.get('/api/request/:request_id', async (req, res) => {
  const { project_id } = req.query;
  const { request_id } = req.params;
  if (!project_id) {
    res.status(400).json({ error: 'project_id is required' });
    return;
  }
  // request_id is required via URL param

  const result = await deepgramGet(`/v1/projects/${project_id}/requests/${request_id}`);
  if (!result.ok) {
    res.status(result.status).json({ error: result.body });
    return;
  }
  res.json(result.body);
});

app.get('/api/feedback', async (req, res) => {
  if (!firestoreDb) {
    res.status(503).json({
      error:
        'Firebase Admin not initialised. Set FIREBASE_SERVICE_ACCOUNT_PATH in .env and restart the server.',
    });
    return;
  }
  const { type, limit } = req.query;
  const limitNum = Math.min(Math.max(Number(limit) || 100, 1), 500);
  try {
    let query = firestoreDb.collection('feedback');
    if (type === 'review' || type === 'bug') {
      query = query.where('type', '==', type);
    }
    query = query.orderBy('serverCreatedAt', 'desc').limit(limitNum);
    const snap = await query.get();
    const items = snap.docs.map((doc) => {
      const data = doc.data();
      // serverCreatedAt is a Firestore Timestamp — normalise to ISO so the
      // browser doesn't need to know about the Admin SDK's types.
      const serverCreatedAt =
        data.serverCreatedAt && typeof data.serverCreatedAt.toDate === 'function'
          ? data.serverCreatedAt.toDate().toISOString()
          : null;
      return { id: doc.id, ...data, serverCreatedAt };
    });
    res.json({ items, count: items.length });
  } catch (e) {
    // eslint-disable-next-line no-console
    console.error('Failed to read feedback:', e);
    res.status(500).json({ error: e.message });
  }
});

// Probe the GitHub raw URL for a given (already-lowercased-by-the-app) name and
// report whether the mp3 exists. The frontend uses this to colour each row of
// the name-requests panel "Awaiting" vs "Recorded" without burdening the
// browser with cross-origin requests directly to GitHub.
const NAME_AUDIO_REPO_BASE =
  'https://raw.githubusercontent.com/sjpalnz/pub_darts_audio/main';

// Extensions to probe, in order. Matches `_kProbeExtensions` in
// `lib/services/custom_names_service.dart` so the inspector and the app agree
// on what counts as a "recorded" name.
const PROBE_EXTENSIONS = ['mp3', 'm4a', 'webm', 'wav'];

app.get('/api/check-name-file', async (req, res) => {
  const { name } = req.query;
  if (typeof name !== 'string' || !name.trim()) {
    res.status(400).json({ error: 'name is required' });
    return;
  }
  const lowered = name.trim().toLowerCase();
  // Cache-buster query param — Fastly may or may not include the query string
  // in its cache key, but adding it costs us nothing and helps when it does.
  const cacheBust = Date.now();
  const headers = {
    'cache-control': 'no-cache',
    pragma: 'no-cache',
  };
  try {
    for (const ext of PROBE_EXTENSIONS) {
      const url =
        `${NAME_AUDIO_REPO_BASE}/${encodeURIComponent(lowered)}.${ext}` +
        `?_=${cacheBust}`;
      const r = await fetch(url, { method: 'HEAD', headers, cache: 'no-store' });
      if (r.ok) {
        res.json({ exists: true, extension: ext, status: r.status, url });
        return;
      }
    }
    res.json({ exists: false, status: 404 });
  } catch (e) {
    res.status(502).json({ error: e.message });
  }
});

// Quick capability check so the frontend can grey-out the Record button up
// front if uploads aren't configured.
app.get('/api/upload-status', (_req, res) => {
  res.json({
    enabled: !!GITHUB_TOKEN,
    repo: `${GITHUB_REPO_OWNER}/${GITHUB_REPO_NAME}`,
    branch: GITHUB_BRANCH,
  });
});

// Same allowed-character rule the Flutter app uses for the request form.
function canonicaliseUploadName(raw) {
  if (typeof raw !== 'string') return '';
  const stripped = raw.replace(/[^A-Za-z ]/g, '');
  return stripped.trim().replace(/\s+/g, ' ').toLowerCase();
}

app.post('/api/upload-name-recording', upload.single('file'), async (req, res) => {
  if (!GITHUB_TOKEN) {
    res.status(503).json({
      error:
        'GITHUB_TOKEN not set. Add a fine-grained PAT to tools/deepgram-inspector/.env and restart the server.',
    });
    return;
  }
  const { name, extension } = req.body ?? {};
  const file = req.file;
  if (!file || !file.buffer || !file.buffer.length) {
    res.status(400).json({ error: 'file is required' });
    return;
  }
  const canonical = canonicaliseUploadName(name);
  if (!canonical) {
    res.status(400).json({ error: 'name is required and must contain letters' });
    return;
  }
  const ext = String(extension || '').toLowerCase();
  if (!ALLOWED_UPLOAD_EXTENSIONS.has(ext)) {
    res.status(400).json({
      error: `extension must be one of: ${[...ALLOWED_UPLOAD_EXTENSIONS].join(', ')}`,
    });
    return;
  }

  const repoPath = `${canonical}.${ext}`;
  const contentsUrl = `https://api.github.com/repos/${GITHUB_REPO_OWNER}/${GITHUB_REPO_NAME}/contents/${encodeURIComponent(repoPath)}`;
  const baseHeaders = {
    Authorization: `Bearer ${GITHUB_TOKEN}`,
    Accept: 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
    'User-Agent': 'darts-app-inspector',
  };

  try {
    // 1. Check if the file already exists so we can include its sha to update.
    const probe = await fetch(`${contentsUrl}?ref=${GITHUB_BRANCH}`, {
      method: 'GET',
      headers: baseHeaders,
    });
    let existingSha = null;
    if (probe.ok) {
      const probeBody = await probe.json();
      existingSha = probeBody?.sha ?? null;
    } else if (probe.status !== 404) {
      const text = await probe.text();
      res.status(probe.status).json({
        error: `GitHub probe failed: ${text || probe.status}`,
      });
      return;
    }

    // 2. PUT the (new or replacement) content.
    const action = existingSha ? 'updated' : 'created';
    const commitMessage = existingSha
      ? `Update recording for ${canonical}`
      : `Add recording for ${canonical}`;
    const putBody = {
      message: commitMessage,
      content: file.buffer.toString('base64'),
      branch: GITHUB_BRANCH,
      ...(existingSha ? { sha: existingSha } : {}),
    };
    const putRes = await fetch(contentsUrl, {
      method: 'PUT',
      headers: { ...baseHeaders, 'Content-Type': 'application/json' },
      body: JSON.stringify(putBody),
    });
    if (!putRes.ok) {
      const text = await putRes.text();
      res.status(putRes.status).json({
        error: `GitHub upload failed: ${text || putRes.status}`,
      });
      return;
    }
    const putBodyJson = await putRes.json();
    res.json({
      ok: true,
      action,
      path: repoPath,
      htmlUrl: putBodyJson?.content?.html_url ?? null,
      sha: putBodyJson?.content?.sha ?? null,
    });
  } catch (e) {
    res.status(502).json({ error: e.message });
  }
});

app.get('/api/name-requests', async (req, res) => {
  if (!firestoreDb) {
    res.status(503).json({
      error:
        'Firebase Admin not initialised. Set FIREBASE_SERVICE_ACCOUNT_PATH in .env and restart the server.',
    });
    return;
  }
  const { limit } = req.query;
  const limitNum = Math.min(Math.max(Number(limit) || 200, 1), 1000);
  try {
    const snap = await firestoreDb
      .collection('nameRequests')
      .orderBy('serverCreatedAt', 'desc')
      .limit(limitNum)
      .get();
    const items = snap.docs.map((doc) => {
      const data = doc.data();
      const serverCreatedAt =
        data.serverCreatedAt && typeof data.serverCreatedAt.toDate === 'function'
          ? data.serverCreatedAt.toDate().toISOString()
          : null;
      return { id: doc.id, ...data, serverCreatedAt };
    });
    res.json({ items, count: items.length });
  } catch (e) {
    // eslint-disable-next-line no-console
    console.error('Failed to read name requests:', e);
    res.status(500).json({ error: e.message });
  }
});

app.listen(port, () => {
  // eslint-disable-next-line no-console
  console.log(`Darts App Inspector running at http://localhost:${port}`);
});

